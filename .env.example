# Keevo local environment
# Database file location (SQLite)
DATABASE_URL=""file:./dev.db""
# Auth.js session secret - generate with: npx auth secret
AUTH_SECRET=""change-me""
# Required for local development over http
AUTH_TRUST_HOST=""true""
# AES-256-GCM encryption key for secret field values at rest (base64, 32 bytes)
# Generate with: node -e ""console.log(require('crypto').randomBytes(32).toString('base64'))""
KEEVO_ENCRYPTION_KEY=""change-me""
